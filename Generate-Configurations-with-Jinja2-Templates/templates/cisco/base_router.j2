!
! Configuration for {{ hostname }}
! Generated on {{ generation_date }}
!
version 15.1
service timestamps debug datetime msec
service timestamps log datetime msec
no service password-encryption
!
hostname {{ hostname }}
!
{% if enable_secret %}
enable secret {{ enable_secret }}
{% endif %}
!
{% block interfaces %}
{% endblock %}
!
{% block routing %}
{% endblock %}
!
line con 0
line aux 0
line vty 0 4
 login
!
end
