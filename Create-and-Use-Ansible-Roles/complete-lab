Task 1: Build a Custom Webserver Role from Scratch
Subtask 1.1: Explore the Standard Role Structure
Create a roles directory and initialize a role skeleton using ansible-galaxy:
cd /home/student/ansible-labs
mkdir -p roles
cd roles
ansible-galaxy init webserver
tree webserver/
Expected result: A webserver/ directory is created containing tasks/, handlers/, templates/, files/, vars/, defaults/, meta/, tests/, and README.md. Each */main.yml file exists but is mostly empty except for a --- header.

Confirm the purpose of each directory by inspecting the generated files:
cat webserver/meta/main.yml
ls -la webserver/tasks webserver/handlers webserver/templates
Deliverable: A working roles/webserver/ skeleton produced by ansible-galaxy init, confirmed with a tree listing showing all seven standard subdirectories.

Subtask 1.2: Define Variables, Tasks, Handlers, and a Template
Set default variables (lowest precedence, safe to override):
cd webserver
cat > defaults/main.yml << 'EOF'
---
# defaults file for webserver
webserver_package: apache2
webserver_service: apache2
webserver_port: 80
webserver_document_root: /var/www/html
webserver_index_file: index.html
webserver_admin_email: admin@example.com
firewall_enabled: true
EOF
Define role-internal variables that are computed from the defaults:
cat > vars/main.yml << 'EOF'
---
# vars file for webserver
webserver_packages:
  - "{{ webserver_package }}"
  - ufw

webserver_directories:
  - "{{ webserver_document_root }}"
  - /var/log/apache2

required_modules:
  - rewrite
  - ssl
EOF
Write the main task list:
cat > tasks/main.yml << 'EOF'
---
# tasks file for webserver
- name: Update package cache
  apt:
    update_cache: yes
    cache_valid_time: 3600
  when: ansible_os_family == "Debian"

- name: Install web server packages
  apt:
    name: "{{ webserver_packages }}"
    state: present
  when: ansible_os_family == "Debian"

- name: Create web server directories
  file:
    path: "{{ item }}"
    state: directory
    owner: www-data
    group: www-data
    mode: '0755'
  loop: "{{ webserver_directories }}"

- name: Enable Apache modules
  apache2_module:
    name: "{{ item }}"
    state: present
  loop: "{{ required_modules }}"
  notify: restart webserver

- name: Configure firewall for web server
  ufw:
    rule: allow
    port: "{{ webserver_port }}"
    proto: tcp
  when: firewall_enabled

- name: Deploy custom index page
  template:
    src: index.html.j2
    dest: "{{ webserver_document_root }}/{{ webserver_index_file }}"
    owner: www-data
    group: www-data
    mode: '0644'
  notify: restart webserver

- name: Start and enable web server service
  systemd:
    name: "{{ webserver_service }}"
    state: started
    enabled: yes

- name: Verify web server is responding
  uri:
    url: "http://{{ ansible_default_ipv4.address }}:{{ webserver_port }}"
    method: GET
    status_code: 200
  delegate_to: localhost
EOF
Define handlers for service restarts, triggered by notify:
cat > handlers/main.yml << 'EOF'
---
# handlers file for webserver
- name: restart webserver
  systemd:
    name: "{{ webserver_service }}"
    state: restarted
  listen: restart webserver

- name: reload webserver
  systemd:
    name: "{{ webserver_service }}"
    state: reloaded
  listen: reload webserver
EOF
